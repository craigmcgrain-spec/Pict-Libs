<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PictLibs" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/bright_purple</item>
        <item name="colorPrimaryVariant">@color/bright_pink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bright_blue</item>
        <item name="colorSecondaryVariant">@color/bright_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="cornerFamily">rounded</item>
        <item name="borderlessButtonStyle">@style/Widget.PictLibs.Button.Rounded</item>
    </style>

    <style name="Widget.PictLibs.Button.Rounded" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">24dp</item>
    </style>
</resources>
